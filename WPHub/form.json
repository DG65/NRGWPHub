{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖 Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "ℹ️ WPHub Version 0.1.0 -- Waermepumpen-Cloud-Anbindung, Start mit Panasonic Comfort Cloud."
                },
                {
                    "type": "Label",
                    "caption": "Verbindet sich mit der Panasonic Comfort Cloud (gleiches Konto wie die offizielle App) und stellt gefundene Aquarea-Waermepumpen dem NRG-Stack-Verbund (z. B. EMS) zur Verfuegung. Klimageraete werden bewusst nicht eingebunden. Details: https://github.com/DG65/NRGWPHub"
                },
                {
                    "type": "Label",
                    "caption": "Ablauf: 1. E-Mail und Passwort eintragen → 2. Übernehmen → 3. „Anmelden und Wärmepumpen suchen“ → 4. „WPHub aktiv“ einschalten und Übernehmen."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🔧 Allgemein",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "WPHUB_Active",
                    "caption": "WPHub aktiv"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WPHUB_Interval",
                    "caption": "Aktualisierungsintervall (Sekunden)",
                    "minimum": 30,
                    "maximum": 600,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "☁️ Panasonic Comfort Cloud",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Label",
                            "caption": "Zugangsdaten werden nur fuer die einmalige Anmeldung verwendet, danach nicht mehr gespeichert -- nur der resultierende Zugangsschluessel."
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Hinweis zur Sicherheit",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "IP-Symcon verschluesselt Attribute NICHT at rest. \"Sicher\" heisst hier: nicht im Formular/Protokoll sichtbar -- keine echte Verschluesselung. Das Passwort wird nur fuer die einmalige Anmeldung verwendet und danach automatisch geleert; gespeichert bleibt nur der Zugangsschluessel (Token). Konten mit Zwei-Faktor-Authentifizierung (2FA) werden noch nicht unterstuetzt."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CC_Email",
                    "caption": "Comfort Cloud E-Mail"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "CC_Password",
                    "caption": "Comfort Cloud Passwort (wird nach der Anmeldung geleert)"
                },
                {
                    "type": "Button",
                    "name": "CC_LoginButton",
                    "caption": "🔑  Anmelden und Wärmepumpen suchen",
                    "onClick": "WPHUB_Login($id);"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "name": "CC_AgreementButton",
                            "caption": "📜  Aktualisierte Bedingungen akzeptieren",
                            "onClick": "WPHUB_AcceptAgreements($id);"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Wann brauche ich das?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "Panasonic verlangt nach Aktualisierungen von Nutzungsbedingungen oder Datenschutzerklaerung eine erneute Zustimmung des Kontos (Cloud-Fehlercode 4103, Instanzstatus \"Zustimmung erforderlich\") -- so wie beim naechsten Start der offiziellen App. Diese Schaltflaeche bestaetigt beides im Namen Deines Kontos; WPHub tut das bewusst NIE automatisch. Die Texte selbst gibt es in der offiziellen App bzw. auf panasonic.com. Alternativ: einmal die offizielle Comfort-Cloud-App oeffnen und dort bestaetigen."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "CC_Result",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "CC_AppVersion",
                            "caption": "App-Version (leer = automatisch)"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Wozu die App-Version?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "Die Comfort Cloud weist Anfragen zu alter App-Versionen ab (Fehlercode 4106). WPHub ermittelt die aktuelle Versionsnummer der offiziellen App dann selbst (Play Store, ersatzweise AppBrain) und verwendet sie automatisch weiter. Dieses Feld ist nur der Notnagel, falls die automatische Ermittlung fehlschlaegt: dann hier die Versionsnummer aus dem Play Store/App Store eintragen und uebernehmen. Eine automatisch ermittelte Version hat Vorrang vor diesem Feld."
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ExtSensorsPanel",
            "caption": "🔌 Externe Sensoren & Zähler (optional)",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Label",
                            "caption": "Die Comfort Cloud liefert keine echte Leistung/Energie und keine Vor-/Rücklauf-/Puffertemperatur. Hier lässt sich optional eine beliebige vorhandene Symcon-Variable verknüpfen (z. B. ein Shelly, MeterHub, ein eigener Fühler) -- WPHub meldet den Wert dann als echte Messung im Verbund-Vertrag statt ihn leer zu lassen. Ist in MeterHub ein Zähler mit der Funktionszuordnung \"Wärmepumpe\" markiert, schlägt WPHub ihn hier automatisch vor."
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Wofür ist das gut?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "WPHub braucht dafür kein bestimmtes anderes Modul -- jede Symcon-Variable geht (Shelly-Instanz, MeterHub, HeishaMon, eigener 1-Wire-Fühler). Verknüpfte Werte tauchen im Verbund-Vertrag (WPHUB_GetFunctions) als echte Messung auf und werden z. B. im Anlagenschema angezeigt. Keine COP-/Arbeitszahl-Berechnung: dafür fehlt WPHub strukturell die erzeugte Wärmemenge (kein Durchfluss, keine Wassermenge), auch mit Stromzähler nicht ableitbar."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "MeterHubSuggestion",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "Button",
                    "name": "MeterHubAdoptButton",
                    "caption": "🔗  Von MeterHub übernehmen",
                    "visible": false,
                    "onClick": "WPHUB_AdoptMeterHubAssignment($id);"
                },
                {
                    "type": "Label",
                    "name": "MeterHubResult",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "SelectVariable",
                    "name": "Ext_PowerVariable",
                    "caption": "Stromzähler: elektrische Leistung der Wärmepumpe (W)"
                },
                {
                    "type": "SelectVariable",
                    "name": "Ext_EnergyVariable",
                    "caption": "Stromzähler: Energiezähler der Wärmepumpe (kWh)"
                },
                {
                    "type": "SelectVariable",
                    "name": "Ext_MainInletTempVariable",
                    "caption": "Fühler: Rücklauftemperatur"
                },
                {
                    "type": "SelectVariable",
                    "name": "Ext_MainOutletTempVariable",
                    "caption": "Fühler: Vorlauftemperatur"
                },
                {
                    "type": "SelectVariable",
                    "name": "Ext_BufferTempVariable",
                    "caption": "Fühler: Puffertemperatur"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Anmeldung an der Comfort Cloud erforderlich -- im Formular anmelden"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zustimmung erforderlich -- Panasonic hat die Bedingungen aktualisiert (Formular)"
        }
    ]
}
