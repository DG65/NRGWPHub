{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖 Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "ℹ️ WPHub Version 0.1.0 -- Waermepumpen-Cloud-Anbindung, Start mit Panasonic Comfort Cloud."
                },
                {
                    "type": "Label",
                    "caption": "Verbindet sich mit der Panasonic Comfort Cloud (gleiches Konto wie die offizielle App) und stellt gefundene Aquarea-Waermepumpen dem NRG-Stack-Verbund (z. B. EMS) zur Verfuegung. Klimageraete werden bewusst nicht eingebunden. Details: https://github.com/DG65/WPHub"
                },
                {
                    "type": "Label",
                    "caption": "Ablauf: 1. E-Mail und Passwort eintragen → 2. Übernehmen → 3. „Anmelden und Wärmepumpen suchen“ → 4. „WPHub aktiv“ einschalten und Übernehmen."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🔧 Allgemein",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "WPHUB_Active",
                    "caption": "WPHub aktiv"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WPHUB_Interval",
                    "caption": "Aktualisierungsintervall (Sekunden)",
                    "minimum": 30,
                    "maximum": 600,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "☁️ Panasonic Comfort Cloud",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Label",
                            "caption": "Zugangsdaten werden nur fuer die einmalige Anmeldung verwendet, danach nicht mehr gespeichert -- nur der resultierende Zugangsschluessel."
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Hinweis zur Sicherheit",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "IP-Symcon verschluesselt Attribute NICHT at rest. \"Sicher\" heisst hier: nicht im Formular/Protokoll sichtbar -- keine echte Verschluesselung. Das Passwort wird nur fuer die einmalige Anmeldung verwendet und danach automatisch geleert; gespeichert bleibt nur der Zugangsschluessel (Token). Konten mit Zwei-Faktor-Authentifizierung (2FA) werden noch nicht unterstuetzt."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CC_Email",
                    "caption": "Comfort Cloud E-Mail"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "CC_Password",
                    "caption": "Comfort Cloud Passwort (wird nach der Anmeldung geleert)"
                },
                {
                    "type": "Button",
                    "name": "CC_LoginButton",
                    "caption": "🔑  Anmelden und Wärmepumpen suchen",
                    "onClick": "WPHUB_Login($id);"
                },
                {
                    "type": "Label",
                    "name": "CC_Result",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "CC_AppVersion",
                            "caption": "App-Version"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "?",
                            "width": "70px",
                            "popup": {
                                "caption": "Wozu die App-Version?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "Die Comfort Cloud weist Anfragen zu alter App-Versionen ab (Fehlercode 4106). Meldet das Protokoll diesen Fehler, hier die aktuelle Versionsnummer der offiziellen Comfort-Cloud-App (Play Store/App Store) eintragen und uebernehmen. Standard: 1.21.0"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Anmeldung an der Comfort Cloud erforderlich -- im Formular anmelden"
        }
    ]
}
